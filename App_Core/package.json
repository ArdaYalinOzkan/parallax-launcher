{
  "name": "parallax-launcher",
  "version": "3.5.1",
  "main": "main.js",
  "author": "Arda Yalın Özkan",
  "license": "GPL-3.0-or-later",
  "description": "Premium Game Library Manager",
  "scripts": {
    "start": "electron . --no-sandbox",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^25.1.8",
    "electron-squirrel-startup": "^1.0.1"
  },
  "build": {
    "appId": "com.ardayalin.parallaxlauncher",
    "productName": "Parallax Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.js",
      "renderer/**/*",
      "Assets_Default/**/*",
      "package.json",
      "!**/*.bak",
      "!**/*.map"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "Assets_Default/AppIcon.png",
      "category": "Game",
      "maintainer": "Arda Yalın Özkan",
      "synopsis": "Game library manager",
      "description": "One shelf for every game you own, kept on your own machine. Finds your installed Steam games, fills in the artwork, and launches them.",
      "desktop": {
        "Categories": "Game;",
        "StartupWMClass": "parallax-launcher"
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "Assets_Default/AppLogo.ico",
      "legalTrademarks": "Parallax Launcher — Arda Yalın Özkan"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ArdaYalinOzkan",
        "repo": "parallax-launcher",
        "releaseType": "release"
      }
    ],
    "deb": {
      "fpm": [
        "packaging/com.ardayalin.parallaxlauncher.metainfo.xml=/usr/share/metainfo/com.ardayalin.parallaxlauncher.metainfo.xml"
      ],
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Parallax Launcher",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArdaYalinOzkan/parallax-launcher.git"
  },
  "homepage": "https://parallaxlauncher.com",
  "bugs": {
    "url": "https://github.com/ArdaYalinOzkan/parallax-launcher/issues"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
