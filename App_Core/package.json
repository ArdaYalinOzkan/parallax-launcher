{
  "name": "parallax-launcher",
  "version": "3.0.0",
  "main": "main.js",
  "author": "Arda Yalın Özkan",
  "license": "GPL-3.0-or-later",
  "description": "Premium Game Library Manager",
  "scripts": {
    "start": "electron . --no-sandbox",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^25.1.8",
    "electron-squirrel-startup": "^1.0.1"
  },
  "build": {
    "appId": "com.ardayalin.parallaxlauncher",
    "productName": "Parallax Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "*.js",
      "renderer/**/*",
      "Assets_Default/**/*",
      "package.json",
      "!**/*.bak",
      "!**/*.map"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "Assets_Default/AppIcon.png",
      "category": "Game",
      "maintainer": "Arda Yalın Özkan",
      "synopsis": "Game library manager",
      "description": "One shelf for every game you own, kept on your own machine. Finds your installed Steam games, fills in the artwork, and launches them.",
      "desktop": {
        "Categories": "Game;"
      }
    },
    "win": {
      "target": "nsis",
      "icon": "Assets_Default/AppLogo.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ArdaYalinOzkan",
        "repo": "parallax-launcher"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArdaYalinOzkan/parallax-launcher.git"
  },
  "homepage": "https://github.com/ArdaYalinOzkan/parallax-launcher",
  "bugs": {
    "url": "https://github.com/ArdaYalinOzkan/parallax-launcher/issues"
  }
}
